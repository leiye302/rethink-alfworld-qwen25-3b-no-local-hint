# Copy to .env and use repository-relative environment paths or PATH commands.
SFT_PYTHON=./.venv-sft/bin/python
OPSD_PYTHON=./.venv-opsd/bin/python
TRAIN_GPUS=0
EVAL_GPU=0
RAY_ADDRESS=local
ALFWORLD_DATA=./data/alfworld
# Optional for Hugging Face access only; never needed for hint generation.
HF_TOKEN=${HF_TOKEN:-}
